{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Evidence Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "dataset_id",
    "run_id",
    "event_type",
    "t_start_s",
    "t_end_s",
    "evidence_status",
    "source_evidence_ids",
    "rule_version"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "pattern": "^[A-Z0-9]+$"},
    "run_id": {"type": "string", "pattern": "^P[0-9]+_T[0-9]+$"},
    "event_type": {
      "enum": [
        "simulator_overshoot",
        "tip_occlusion",
        "under_ledge_candidate",
        "performance_bout",
        "boundary_work"
      ]
    },
    "t_start_s": {"type": "number", "minimum": 0},
    "t_end_s": {"type": "number", "minimum": 0},
    "phase": {"type": ["string", "null"]},
    "anatomy": {"type": ["string", "null"]},
    "evidence_status": {
      "enum": ["candidate", "simulator_supported", "human_confirmed", "human_rejected"]
    },
    "lifecycle_status": {"enum": ["open", "updated", "closed"]},
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "attributes": {"type": "object"},
    "rule_version": {"type": "string", "minLength": 1}
  }
}
