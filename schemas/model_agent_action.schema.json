{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_agent_action.schema.json",
  "title": "Guarded Model Agent Action",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "tool_calls"],
      "properties": {
        "action": {"const": "call_tools"},
        "tool_calls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_name", "arguments"],
            "properties": {
              "tool_name": {"type": "string", "minLength": 1},
              "arguments": {"type": "object"}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "claims"],
      "properties": {
        "action": {"const": "submit_claims"},
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        }
      }
    }
  ]
}
